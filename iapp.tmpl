#TMSH-VERSION: 14.0.0

cli admin-partitions {
    update-partition Common
}
sys application template /Common/sslo-cert-revocation-checking {
    actions {
        definition {
            html-help {
<h2>CRLSet and OneCRL: What, why and how.</h2>
<p>CRLSet and OneCRL are custom certificate revocation systems developed by Google and Mozilla to overcome the performance and reliability issues of traditional revocation checking methods such as CRLs and OCSP.</p>
<p>These systems exist to provide a more efficient way for browsers to identify and block untrustworthy SSL/TLS security certificates without performing slow, live online checks for every connection.</p>
<p>Google's CRLSet is designed for rapid, emergency revocation of specific website certificates, providing a quick response to immediate threats. In contrast, Mozilla's OneCRL, in contrast, focuses on the structural risk of compromised intermediate certificates, which can be used to fraudulently issue trusted certificates for countless domains.</p>
<p>Their importance lies in offering a practical solution to the otherwise "broken" state of certificate revocation, which often suffers from high latency and privacy concerns.</p>
<p>By pushing revocation lists to the browser, CRLSet and OneCRL allow for fast, local checks that improve both security and performance. This proactive approach is especially vital for responding to significant security events, such as a compromised intermediate CA certificate or fraudulent end-entity certificate, thereby providing an essential layer of protection for web users.</p>

<h2>F5 SSL Orchestrator: Unifying Certificate Revocation checking</h2>

By integrating both Google's CRLSet and Mozilla's OneCRL, F5 SSL Orchestrator centralizes certificate revocation into a decisive, network-wide enforcement point.

This is a game-changer because it not only closes the gap between browser and network security, it merges both complementary methods therefore covering different, critical types of certificate risk that no one else can provide.
            }
            implementation {

#############################################################################
#
# iApp: CRLSetOneCRL-ssl-certificate-revocation-checking
# version: 1.1 @ 2025-06-28
# author: Simon Kowallik <s.kowallik@f5.com>
# version history:
#   1   @ 2017-12-10: initial release
#   1.1 @ 2025-06-28: updated for TMOS v17.5
# 
#############################################################################

set iRule_code {
# DO NOT EDIT THIS FILE DIRECTLY AS THIS IRULE IS AUTOMATICALLY GENERATED AND WILL BE OVERWRITTEN
#
# Attach this iRule to a SSL/TLS Forward Proxy Virtual Server to enable certificate revocation checking.
#
when SERVERSSL_CLIENTHELLO_SEND priority 919 {
    # identifier for revocation status caching per destination (dlal -> denylistallowlist)
# <% if {$::config_extractSNI eq "SSLo"} { %>
    # fetch SNI from SSLo sharedvar
    sharedvar ctx
    set dlal_ident "[IP::server_addr]:[TCP::remote_port]:$ctx(SNI)"
    if {$ctx(SNI) eq {}} {log local0.warn {warning: SNI could not be read or is empty - revocation status caching per destination IP:PORT}}
# <% } elseif {$::config_extractSNI eq "custom"} { %>
    # fetch SNI from custom variable
    set dlal_ident "[IP::server_addr]:[TCP::remote_port]:$CRVC_SNI"
    if {$CRVC_SNI eq {}} {log local0.warn {warning: SNI could not be read or is empty - revocation status caching per destination IP:PORT}}
# <% } else { %>
    # fetch SNI from SSL::extensions
    if {[SSL::extensions exists -type 0]} {
        binary scan [SSL::extensions -type 0] H* tls_servername
        set dlal_ident "[IP::server_addr]:[TCP::remote_port]:$tls_servername"
    } else {
        set dlal_ident "[IP::server_addr]:[TCP::remote_port]:"
        log local0.warn "warning: SNI could not be read - revocation status caching per destination IP:PORT"
    }
# <% } %>

# <% if {$::config_revocation_cache} { %>
    set CRVC_revcache_add_valid 0
# <% if {!$::config_blocking} { %>
    set CRVC_blockingdisabled_blocked 0
# <% } %>
    if {[set CRVC_revcache_status [call revocation_cache_lookup $dlal_ident]] starts_with {revoked}} {
# <% if {$::config_revocation_cache_revoked_log} { %>
        call audit_log "connection to $dlal_ident blocked due to cached revocation status: $CRVC_revcache_status"
# <% } %>
# <% if {$::config_blocking} { %>
        call blocking_action
# <% } else { %>
        set CRVC_blockingdisabled_blocked 1
# <% } %>
    }
# <% } %>
}
when SERVERSSL_SERVERCERT priority 500 {
# <% if {$::config_crlset} { %>
    set crlset_blocked_issuers {}
    set CRVC_previous_cert_serial {}
# <% } %>
# <% if {$::config_revocation_cache} { %>
    if {$CRVC_revcache_status eq {valid}}
    {
        return
    }
# <% } %>
if {[set CRVC_cert_count [SSL::cert count]] ne {0}} {
    for {set CRVC_cert_no 0} {$CRVC_cert_no <= $CRVC_cert_count} {incr CRVC_cert_no} {
        if {$CRVC_cert_no < $CRVC_cert_count} {
            # cert set to issuer on last for loop
            set CRVC_cert [SSL::cert $CRVC_cert_no]
        } elseif {$CRVC_cert eq {}} {
            # break if cert is empty (eg. issuer for self-signed or untrusted chain or SSL session resumption)
            break
        }

        set CRVC_cert_serial [string map {{:} {}} [X509::serial_number $CRVC_cert]]

# <% if {$::config_crlset} { %>
        set CRVC_cert_spki_hash [call X509__spki_hash $CRVC_cert]
# <% if {$::config_crlset_block_on_spkihash_failure} { %>
        if {$CRVC_cert_spki_hash eq {} || $CRVC_cert_spki_hash starts_with {Error:}} {
            call audit_log "certificate SPKI hash could not be calculated. serialno:$CRVC_cert_serial, error: $CRVC_cert_spki_hash"
# <% if {$::config_blocking} { %>
            call blocking_action
            return
# <% } elseif {$::config_revocation_cache} { %>
            set CRVC_blockingdisabled_blocked {1}
# <% } %>
        }
# <% } %>
# <% } %>

# <% if {$::debuglogging_certificate_chain} { %>
        call log_debug "+--\[certificate #$CRVC_cert_no/$CRVC_cert_count\]--\[ident: $dlal_ident\]-------------"
        set debug_cert_subject [X509::subject $CRVC_cert]
        set debug_cert_issuer [X509::issuer $CRVC_cert]
        call log_debug "| subject: $debug_cert_subject"
        call log_debug "| issuer.: $debug_cert_issuer"
        call log_debug "| Signature Alg: [X509::signature_algorithm $CRVC_cert]"
        if {$debug_cert_issuer eq $debug_cert_subject} { call log_debug "| ROOT CA: subject == issuer" }
        call log_debug "| serial_number: $CRVC_cert_serial"
# <% if {$::config_crlset} { %>
        call log_debug "| spki_hash: >${CRVC_cert_spki_hash}<"
# <% } %>
        call log_debug "+------------------------------------------------------------"
# <% } %>

# <% if {$::config_onecrl} { %>
        # OneCRL - check if we have a list of blocked issuers for the cert serial
        if {[set onecrl_blocked_issuers [class match -value -- $CRVC_cert_serial equals <%=$::dg_onecrl%>]] ne {}} {
# <% if {$::debuglogging_onecrl_blockedissuers} { %>
            call log_debug "found onecrl_blocked_issuers(#[llength $onecrl_blocked_issuers]) for serialno:$CRVC_cert_serial - certificate possibly revoked (issuers: $onecrl_blocked_issuers)"
# <% } %>
            # convert binary cert to hex
            binary scan $CRVC_cert H* CRVC_cert_hex

            # check certificate for blocked issuers
            foreach blocked_issuer $onecrl_blocked_issuers {
                # check if cert_hex contains the blocked_issuer
                if {$CRVC_cert_hex contains $blocked_issuer} {
                    call audit_log "certificate blocked by OneCRL: serialno:$CRVC_cert_serial, issuer:$blocked_issuer"
# <% if {$::config_revocation_cache} { %>
                    call revocation_cache_add $dlal_ident [list {revoked} {OneCRL} $CRVC_cert_serial [X509::issuer $CRVC_cert]]
# <% } %>
# <% if {$::config_blocking} { %>
                    call blocking_action
                    return
# <% } elseif {$::config_revocation_cache} { %>
                    set CRVC_blockingdisabled_blocked {1}
# <% } %>
                }
            }
        }
# <% } %>

# <% if {$::config_crlset} { %>
        if {[set reason [class match -value -- $CRVC_cert_spki_hash equals <%=$::dg_explicit_spki%>]] ne {}}
        {
            # spki hash explicitly blocked (reason: either CRLSet or Custom)
            call audit_log "certificate SPKI hash explicitly blocked: SPKI hash:$CRVC_cert_spki_hash, reason:$reason"
# <% if {$::config_revocation_cache} { %>
            call revocation_cache_add $dlal_ident [list {revoked} {CRLSet} $CRVC_cert_spki_hash]
# <% } %>
# <% if {$::config_blocking} { %>
            call blocking_action
            return
# <% } elseif {$::config_revocation_cache} { %>
            set CRVC_blockingdisabled_blocked {1}
# <% } %>
        }
        if {$crlset_blocked_issuers contains $CRVC_cert_spki_hash} {
            # blocked by CRLSet - previous cert in chain is revoked
            call audit_log "certificate blocked by CRLSet: serialno:$CRVC_previous_cert_serial SPKI hash of issuer:$CRVC_cert_spki_hash"
# <% if {$::config_revocation_cache} { %>
            call revocation_cache_add $dlal_ident [list {revoked} {CRLSet} $CRVC_cert_spki_hash $CRVC_previous_cert_serial]
# <% } %>
# <% if {$::config_blocking} { %>
            call blocking_action
            return
# <% } elseif {$::config_revocation_cache} { %>
            set CRVC_blockingdisabled_blocked {1}
# <% } %>
        }
        # save cert_serial for CRLSet logging (above)
        set CRVC_previous_cert_serial $CRVC_cert_serial

        # extract issuer spki hashes for current cert serial, if not empty cert might be revoked if the issuing cert is included
        set crlset_blocked_issuers [class match -value -- $CRVC_cert_serial equals <%=$::dg_crlset%>]
# <% if {$::debuglogging_crlset_blockedissuers} { %>
        if {$crlset_blocked_issuers ne {}} {call log_debug "found crlset_blocked_issuers([llength $crlset_blocked_issuers]) for serialno:$CRVC_cert_serial - certificate possibly revoked (issuers: $crlset_blocked_issuers)"}
# <% } %>
# <% } %>

# <% if {$::config_revocation_cache} { %>
        set CRVC_revcache_add_valid {1}
# <% } %>
# <% if {$::config_block_weaksigalgo} { %>
        # save signature algorithm for current cert
        set CRVC_sigalgo [X509::signature_algorithm $CRVC_cert]
# <% } %>

        # save issuer cert for last cert in chain. this is the trusted CA in our ca-bundle (might be empty if untrusted certs allowed)
        if {[expr {$CRVC_cert_no + 1}] eq $CRVC_cert_count} {
            # in case the server sends the ROOT CA in the handshake, the issuer will equal the subject
            if {[X509::issuer $CRVC_cert] ne [X509::subject $CRVC_cert]} {
                set CRVC_cert [SSL::cert issuer $CRVC_cert_no]
            } else {
                # continue if the ROOT CA is part of the tls handshake
                continue
            }
        }
# <% if {$::config_block_weaksigalgo && $::config_weaksigalgo_level} { %>
        if {$CRVC_cert_no ne $CRVC_cert_count && ($CRVC_sigalgo eq {sha1WithRSAEncryption} || $CRVC_sigalgo eq {md5WithRSAEncryption})}
# <% } elseif {$::config_block_weaksigalgo && !$::config_weaksigalgo_level} { %>
        if {$CRVC_cert_no eq {1} && ($CRVC_sigalgo eq {sha1WithRSAEncryption} || $CRVC_sigalgo eq {md5WithRSAEncryption})}
# <% } %>
# <% if {$::config_block_weaksigalgo} { %>
        {
            call audit_log "certificate blocked due to weak signature algorithm: serialno:$CRVC_cert_serial, algorithm:$CRVC_sigalgo"
# <% if {$::config_revocation_cache} { %>
            call revocation_cache_add $dlal_ident [list {revoked} {WeakSignature} $CRVC_sigalgo $CRVC_cert_serial [X509::issuer $CRVC_cert]]
# <% } %>
# <% if {$::config_blocking} { %>
            call blocking_action
            return
# <% } elseif {$::config_revocation_cache} { %>
            set CRVC_blockingdisabled_blocked 1
# <% } %>
        }
# <% } %>
    # for loop end
    }
# <% if {$::config_revocation_cache && $::config_blocking} { %>
    if {$CRVC_revcache_add_valid} {
        call revocation_cache_add $dlal_ident {valid}
    }
# <% } elseif {$::config_revocation_cache} { %>
    if {$CRVC_revcache_add_valid && !$CRVC_blockingdisabled_blocked} {
        call revocation_cache_add $dlal_ident {valid}
    }
# <% } %>
}
}
# <% if {$::config_revocation_cache} { %>
proc revocation_cache_add {CRVC_key status} {
# <% if {$::config_revocation_cache_transparency} { %>
    table set -subtable "<%=$::tbl_key%>" -- $CRVC_key $status indefinite <%=$::revocationcache_lifetime%>
# <% } else { %>
    table set -- "<%=$::tbl_key%>_${CRVC_key}" $status indefinite <%=$::revocationcache_lifetime%>
# <% } %>
# <% if {$::debuglogging_revcache_add} { %>
    call log_debug "revocation_cache_add: adding entry for: $CRVC_key with status: $status"
# <% } %>
}
proc revocation_cache_lookup {CRVC_key} {
# <% if {$::config_revocation_cache_transparency} { %>
    set status [table lookup -subtable "<%=$::tbl_key%>" -- $CRVC_key]
# <% } else { %>
    set status [table lookup -- "<%=$::tbl_key%>_${CRVC_key}"]
# <% } %>
# <% if {$::debuglogging_revcache_lookup} { %>
    call log_debug "revocation_cache_lookup: lookup:>${CRVC_key}< returned value:>${status}<"
# <% } %>
    return $status
}
# <% } %>
# <% if {$::config_blocking} { %>
proc blocking_action {} {
# <% if {$::debuglogging_block_log} { %>
    call log_debug "blocking_action: rejected connection [IP::client_addr]:[TCP::client_port] -> [IP::server_addr]:[TCP::server_port]"
# <% } %>
    clientside {reject}
    serverside {reject}
}
# <% } %>
proc audit_log {CRVC_msg} {
# <% if {$::logconfig_log_hsl eq "1"} { %>
    if { ![info exists hsl] } {
        set hsl [HSL::open -publisher <%=$::config_LOG_PUBLISHER%>]
    }
    HSL::send $hsl "<<%=$::config_SYSLOG_NUMBER%>> BLOCK: $CRVC_msg"
# <% } elseif {$::logconfig_log_hsl eq "2"} { %>
    ACCESS::log ssl-orchestrator.notice "[virtual name] BLOCK: $CRVC_msg"
# <% } else { %>
    log local0.warning "BLOCK: $CRVC_msg"
# <% } %>
}
# <% if {$::debuglogging_enabled} { %>
proc log_debug {CRVC_msg} {
# <% if {$::debuglogging_include_virtual} { %>
    log local0.debug "DEBUG:[virtual name]: $CRVC_msg"
# <% } else { %>
    log local0.debug "DEBUG: $CRVC_msg"
# <% } %>
}
# <% } %>
proc X509__spki_hash {cert} {
    # X509::spki_hash does not exist. This is the pure-tcl implementation.
    set _spki [call extract_spki $cert]
    if { !($_spki starts_with {Error}) } {
        binary scan [CRYPTO::hash -alg sha256 $_spki] H* _spki_hash
        return $_spki_hash
    } else {
        return $_spki
    }
}
proc parse_der_tag_length {data_var offset_var} {
    # DER Tag Length parsing
    upvar $data_var data
    upvar $offset_var offset
    
    # read tag byte & jump to next byte
    binary scan $data @${offset}c tag
    incr offset
    set tag [expr {$tag & 0xff}]
    
    # read length byte & jump to next byte
    binary scan $data @${offset}c len_byte
    incr offset
    set len_byte [expr {$len_byte & 0xff}]
    
    if {$len_byte & 0x80} {
        # long form length, 0x80 (highest bit set) indicates long form
        set len_octets [expr {$len_byte & 0x7f}]
        if {$len_octets eq 0} {
            set tag {zero length not allowed in DER long length form}
        } else {
            set length 0
            for {set i 0} {$i < $len_octets} {incr i} {
                binary scan $data @${offset}c byte
                incr offset
                set byte [expr {$byte & 0xff}]
                set length [expr {($length << 8) | $byte}]
            }
        }
    } else {
        # short form length - just one byte
        set length $len_byte
    }
    return [list $tag $length]
}
proc extract_spki {x509cert} {
    # parsing the DER sequences to extract the SPKI
    # https://datatracker.ietf.org/doc/html/rfc5280#section-4.1
    # Alternatives:
    #  - X509::subject_public_key (type, bits, curve) then create a map with extensive string formatting to end up with a binary SPKI -> dirty
    #  - based on X509::subject_public_key, walk backwards to identify the crypto algorithm/type -> dirty
    set offset 0
    
    # outer Certificate SEQUENCE(0x30)
    set result [call parse_der_tag_length x509cert offset]
    if {[lindex $result 0] != 0x30} {
        return "Error: Expected SEQUENCE(0x30) at certificate start, got:[lindex $result 0]"
    }
    
    # skip TBSCertificate SEQUENCE(0x30)  
    set result [call parse_der_tag_length x509cert offset]
    if {[lindex $result 0] != 0x30} {
        return "Error: Expected TBSCertificate SEQUENCE(0x30), got:[lindex $result 0]"
    }
    
    # skip TBSCertificate:version (context)
    # https://cabforum.org/working-groups/server/baseline-requirements/documents/CA-Browser-Forum-TLS-BR-2.1.5.pdf
    # 7.1.1 Version number(s) -> Certificates MUST be of type X.509 v3.
    set result [call parse_der_tag_length x509cert offset]
    if {[lindex $result 0] != 0xa0} {
        return "Error: Expected version EXPLICIT(0xa0) (CAB Forum TLS-BR 7.1.1), got:[lindex $result 0]"
    }
    incr offset [lindex $result 1]
    
    # skip TBSCertificate:serial number (INTEGER)
    set result [call parse_der_tag_length x509cert offset]
    if {[lindex $result 0] != 0x02} {
        return "Error: Expected serial number INTEGER(0x02), got:[lindex $result 0]"
    }
    incr offset [lindex $result 1]
    
    # skip TBSCertificate:signature algorithm (SEQUENCE(0x30))
    set result [call parse_der_tag_length x509cert offset]
    if {[lindex $result 0] != 0x30} {
        return "Error: Expected signature algorithm SEQUENCE(0x30), got:[lindex $result 0]"
    }
    incr offset [lindex $result 1]
    
    # skip TBSCertificate:issuer (SEQUENCE(0x30))
    set result [call parse_der_tag_length x509cert offset]
    if {[lindex $result 0] != 0x30} {
        return "Error: Expected issuer SEQUENCE(0x30), got:[lindex $result 0]"
    }
    incr offset [lindex $result 1]

    # skip TBSCertificate:validity (SEQUENCE(0x30))
    set result [call parse_der_tag_length x509cert offset]
    if {[lindex $result 0] != 0x30} {
        return "Error: Expected validity SEQUENCE(0x30), got:[lindex $result 0]"
    }
    incr offset [lindex $result 1]
    
    # skip TBSCertificate:subject (SEQUENCE(0x30))
    set result [call parse_der_tag_length x509cert offset]
    if {[lindex $result 0] != 0x30} {
        return "Error: Expected subject SEQUENCE(0x30), got:[lindex $result 0]"
    }
    incr offset [lindex $result 1]
    
    # Found TBSCertificate:SubjectPublicKeyInfo (SEQUENCE(0x30))
    set spki_start $offset
    set result [call parse_der_tag_length x509cert offset]
    if {[lindex $result 0] != 0x30} {
        return "Error: Expected SubjectPublicKeyInfo SEQUENCE(0x30), got:[lindex $result 0]"
    }
    set spki_length [lindex $result 1]
    
    # extract spki data
    set spki_total_length [expr {$offset - $spki_start + $spki_length}]
    binary scan $x509cert @${spki_start}a${spki_total_length} spki_data
    
    return $spki_data
}
}
set APIiRule_code {
# DO NOT EDIT THIS FILE DIRECTLY AS THIS IRULE IS AUTOMATICALLY GENERATED AND WILL BE OVERWRITTEN
#
# Note: It is strongly recommended to front this iRule with authentication and authorization (Hello APM use-case :)) to prohibit unauthorized access to the API.
#
# Attach this iRule to a HTTP(s) virtual server of the same traffic group as the SSL/TLS Forward Proxy Virtual Server
# This is important, otherwise this iRule will not be able to read the tables and hence not work!
#
when RULE_INIT {
    # static variables are keyed, this is important to avoid collision with other iRules that could potentially use the same variable names
    # initialize per-TMM cache for table keys and pages
    # while it is not guaranteed that a user will always hit the same TMM, it does reduce the performance impact of this iRule, especially with multiple users
    set static::k<%=$::tbl_key%>_per_tmm_cache_table_keys {}
    set static::k<%=$::tbl_key%>_per_tmm_cache_table_pages 0
    after 5000 -periodic {
        # flush the per-TMM cache every 5 seconds
        # interval is fixed at this point, possibly could be made configurable in the future
        set static::k<%=$::tbl_key%>_per_tmm_cache_table_keys {}
        set static::k<%=$::tbl_key%>_per_tmm_cache_table_pages {}
    }
}
when HTTP_REQUEST {
    # API endpoints, support trailing slash in the path by just trimming it
    switch -glob -- [HTTP::method],[string trimright [HTTP::path] {/}] {
        {GET,} {call http_html_respond 200 [call frontend_html]}
        {GET,/openapi.json} {call http_json_respond 200 [call openapi_schema]}
        {GET,/rapidoc} {call http_html_respond 200 [call rapidoc_html]}
# <% if {$::config_revocation_cache_transparency} { %>
        {GET,/cache/pages} {
                # could be thousands of entries, so we paginate the results with a page size of 100
                # we use per-tmm caching to avoid recalculating the number of pages on every request
                # page size is fixed at this point, possibly could be made configurable in the future
                if {$static::k<%=$::tbl_key%>_per_tmm_cache_table_pages eq {}} {
                    set static::k<%=$::tbl_key%>_per_tmm_cache_table_pages [call ceil [expr {[table keys -subtable "<%=$::tbl_key%>" -count] / 100.0}]]
                }
                call http_json_respond 200 "{\"pages\":$static::k<%=$::tbl_key%>_per_tmm_cache_table_pages}"
            }
        {GET,/cache/page/*} {
                # page is an int, provided as a path parameter (fastest option)
                set page [getfield [HTTP::path] {/} 4]
                if {not [string is integer -strict $page]} {
                    call http_json_respond 400 {{"error":"page must be an integer"}}
                    return
                }
                # we use per-tmm caching to avoid recalculating the number of pages on every request
                if {$static::k<%=$::tbl_key%>_per_tmm_cache_table_keys eq {}} {
                    set static::k<%=$::tbl_key%>_per_tmm_cache_table_keys [table keys -subtable "<%=$::tbl_key%>" -notouch --]
                }
                set json_object_parts {}
                # walk through the keys to get pages
                foreach key [lrange $static::k<%=$::tbl_key%>_per_tmm_cache_table_keys [expr {int($page * 100)}] [expr {int(($page + 1) * 100) - 1}]] {
                    set value [table lookup -subtable "<%=$::tbl_key%>" -notouch -- $key]
                    lappend json_object_parts "{\"key\":\"$key\",\"value\":\"$value\"}"
                }
                call http_json_respond 200 "\[[join $json_object_parts ","]\]"
            }
        {DELETE,/cache} {
                table delete -subtable "<%=$::tbl_key%>" -all --
                HTTP::respond 204 content {}
            }
        {DELETE,/cache/entry/*} {
                set entry [URI::decode [getfield [HTTP::path] {/} 4]]
                table delete -subtable "<%=$::tbl_key%>" -- $entry
                HTTP::respond 204 content {}
            }
        {GET,/cache*} {call http_json_respond 400 {{"error":"unknown endpoint"}}}
        {*,/cache*} {call http_json_respond 405 {{"error":"endpoint only supports GET method"}}}
# <% } else { %>
        {*,/cache*} {call http_json_respond 400 {{"error":"endpoint disabled"}}}
# <% } %>
        {GET,/crlset} {call http_json_respond 200 [call get_crlset]}
        {GET,/crlset/spkis} {call http_json_respond 200 [call get_crlset_spki]}

        {GET,/onecrl} {call http_json_respond 200 [call get_onecrl]}

        {*,/crlset} {call http_json_respond 405 {{"error":"endpoint only supports GET method"}}}
        {*,/onecrl} {call http_json_respond 405 {{"error":"endpoint only supports GET method"}}}
        default {
            call http_json_respond 400 {{"error":"unknown endpoint"}}
        }
    }
}
proc http_json_respond {status json_data} {
    HTTP::respond $status content $json_data {Content-Type} {application/json}
}
proc http_html_respond {status html_data} {
    HTTP::respond $status content $html_data {Content-Type} {text/html}
}
proc get_crlset_spki {} {
    set spkis [string map [list { } {","}] [class names <%=$::dg_explicit_spki%>]]
