t fetch('/onecrl');if(!response.ok){throw new Error('Failed to fetch OneCRL data')}this.onecrlData=await response.json()}catch(error){this.error=`Error loading OneCRL: ${error.message }`}finally{this.loading=false}},async fetchCRLSet(){this.loading=true;try{const response=await fetch('/crlset');if(!response.ok){throw new Error('Failed to fetch CRLSet data')}this.crlsetData=await response.json()}catch(error){this.error=`Error loading CRLSet: ${error.message }`}finally{this.loading=false}},async fetchCRLSetSpkis(){this.loading=true;try{const response=await fetch('/crlset/spkis');if(!response.ok){throw new Error('Failed to fetch CRLSet SPKIs')}this.crlsetSpkis=await response.json()}catch(error){this.error=`Error loading CRLSet SPKIs: ${error.message }`}finally{this.loading=false}},async fetchCachePages(){this.loading=true;try{const response=await fetch('/cache/pages');if(!response.ok){throw new Error('Failed to fetch cache pages')}const data=await response.json();this.totalPages=data.pages;this.currentPage=0;if(this.totalPages>0){await this.fetchCachePage(0)}}catch(error){this.error=`Error loading cache pages: ${error.message }`}finally{this.loading=false}},async fetchCachePage(pageNumber){this.loading=true;try{const response=await fetch(`/cache/page/${ pageNumber }`);if(!response.ok){throw new Error('Failed to fetch cache page')}this.cacheData=await response.json();this.currentPage=pageNumber;this.applyCacheFilter()}catch(error){this.error=`Error loading cache page: ${error.message }`}finally{this.loading=false}},applyCacheFilter(){switch(this.cacheFilter){case 'valid':this.filteredCacheData=this.cacheData.filter(entry=>entry.value==='valid');break;case 'revoked':this.filteredCacheData=this.cacheData.filter(entry=>entry.value.startsWith('revoked'));break;default:this.filteredCacheData=this.cacheData}},async changePage(newPage){if(newPage>=0&&newPage<this.totalPages){await this.fetchCachePage(newPage)}},async clearCache(){if(!confirm('Are you sure you want to clear all