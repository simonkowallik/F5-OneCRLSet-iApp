section intro {
    message hello "This iApp enables Certificate Revocation checking on the Server-Side using Mozilla's OneCRL and Google Chromes CRLSet."
    message prereqs_1 "Before using this iApp, please ensure that all Virtual Servers and profiles are already created and the BIG-IP system is licensed properly. The iApp will generate the iRule and iCalls to update the OneCRL/CRLSet. Direct internet access and name resolution from the BIG-IP is required."
    message prereqs_2 "The created iRule has to be attached to all SSL/TLS egress Virtual Servers. Data Groups will only be created on the BIG-IP which is used to create the Application Service using this iApp. The Data Groups on any other BIG-IP in the same DSC will be created with the first OneCRL/CRLSet update. Please make sure the Data Groups are created before the iRule is used, otherwise TCL errors will occur and connections will fail."
    message ver "1.1 @ 2025-06-28, tested with TMOS v17.5"
    message author "Simon Kowallik <s.kowallik@f5.com>"
}

section agreement {
    message info "This iApp uses Google Chrome CRLSet and Mozilla OneCRL. F5 is not liable for and does not support this solution through F5 technical support. There is no guarantee for the correct function, functionality, performance or security of this solution."
    choice agree default "0" display "xxlarge" tcl { return "I fully understand that all responsibility and liability solely lies with me.\t1\nI do not agree.\t0\n" }
}
optional (agreement.agree == "1") {
section cfg {
    editchoice update_interval default "14400" display "xlarge" tcl { return "24hrs (86400 sec)\t86400\n12hrs (43200 sec)\t43200\n4hrs (14400 sec)\t14400\n" }
    choice config_extractSNI default "1" display "xlarge" tcl { return "SSLo\tSSLo\ncustom TCL variable (\$CRVC_SNI)\tcustom\nserver_name TLS extension\textension\n" }
    optional (cfg.config_extractSNI == "SSLo") {
        message config_extractSNI_SSLo "SSLo is required."
    }
    optional (cfg.config_extractSNI == "custom") {
        message config_extractSNI_custom "The iRule expects the $CRVC_SNI variable name with the SNI as its value. You need to make sure it exists, even if it is empty."
    }
    optional (cfg.config_extractSNI == "extension") {
        message config_extractSNI_extension "The iRule will try to read the SNI from the server-side ClientHello server_name TLS extension field."
    }
    choice save_config default "1" display "xlarge" tcl { return "Yes\t1\nNo\t0\n" }
}
section blockingconfig {
    choice config_blocking default "1" display "xlarge" tcl { return "Yes\t1\nNo\t0\n" }

    choice config_revocation_cache default "1" display "xlarge" tcl { return "Yes\t1\nNo\t0\n" }
    optional (blockingconfig.config_revocation_cache == "1") {
        message warn "Revocation status caching can potentially cause problems if the server_name (SNI) is not available. Revocation status caching would use the destination IP+PORT instead of IP+PORT+SNI. This could cause false positives or false negatives with websites using virtual hosting based on the SNI (server_name)."
        choice config_revocation_cache_revoked_log default "0" display "xlarge" tcl { return "Yes\t1\nNo\t0\n" }
        editchoice revocationcache_lifetime default "3600" display "xlarge" tcl { return "60 sec\t60\n1hr (3600 sec)\t3600\n4hrs (14400 sec)\t14400\n" }

        choice config_revocation_cache_transparency default "1" display "xlarge" tcl { return "Yes\t1\nNo\t0\n" }
        optional (blockingconfig.config_revocation_cache_transparency == "1") {
            message warn2 "Revocation status caching transparency is enabled. This will allow you to inspect and control the revocation cache but reduces performance due to the use of subtables."
            message info2 "Make sure the virtual server (it's virtual address) is using the same traffic group as the SSL Forward Proxy Virtual Server, otherwise the table cannot be accessed."
        }
        message info "Add the revocation_cache_inspection iRule to a HTTP/HTTPS Virtual Server to inspect and control the cache. It is advised to apply further access controls to the Virtual Server, eg. by utilizing APM or mTLS."
    }
}
section transparency_vs {
    choice config_transparency default "1" display "xlarge" tcl { return "Yes\t1\nNo\t0\n" }
    optional (config_transparency == "1") {
        string virtual_address default "10.1.10.101" display "xlarge"
    }
}
section weak_sigalgo {
    choice config_block_weaksigalgo default "0" display "xlarge" tcl { return "Yes\t1\nNo\t0\n" }
    optional (weak_sigalgo.config_block_weaksigalgo == "1") {
        choice config_weaksigalgo_level default "0" display "xlarge" tcl { return "All certificates, except ROOT CA\t1\nFirst intermediate only\t0\n" }
    }
}
section crlsetcfg {
    choice config_crlset default "1" display "xlarge" tcl { return "Yes\t1\nNo\t0\n" }
    optional (crlsetcfg.config_crlset == "1") {
        optional (blockingconfig.config_blocking == "1") {
            choice config_crlset_block_on_spkihash_failure default "1" display "xlarge" tcl { return "Yes\t1\nNo\t0\n" }
            
        }
    }
}
section onecrlcfg {
    choice config_onecrl default "1" display "xlarge" tcl { return "Yes\t1\nNo\t0\n" }
}
section logconfig {
    choice config_log_hsl default "0" display "xlarge" tcl { return "SSLo integrated\t2\nLog-Publisher\t1\n/var/log/ltm\t0\n" }

    optional (logconfig.config_log_hsl == "1") {
        choice config_LOG_PUBLISHER display "xlarge" default "" tcl {
            package require iapp 1.1.1
            return [iapp::get_items sys log-config publisher]
        }
        editchoice config_SYSLOG_NUMBER default "132" display "xlarge" tcl { return "188 (local7.warning)\t188\n132 (local0.warning)\t132\n137\t137" }
    }
}

section demo {
    message info "This sections let's you configure demo data in addition to the real revocation data, for demonstration purposes. Only use for testing and demo purposes, not in production!"
    choice enable default "1" display "xlarge" tcl { return "Yes\t1\nNo\t0\n" }
    optional (enable == "1") {
        string serial default "06832060eaf44f5266b07ad4f8a9bebe0e65" display "xlarge"
        string issuer_spki_hash default "d016e1fe311948aca64f2de44ce86c9a51ca041df6103bb52a88eb3f761f57d7" display "xlarge"
        message note "To find out the serial number and issuer SPKI hash, best use the debug logging feature below."
    }
}

