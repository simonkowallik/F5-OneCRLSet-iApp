### implementation / object creation

# prevent OneCRL/CRLSet to sync in a DSC - every BIG-IP fetches updates independently
set ::no_sync_folder [iapp::conf create sys folder /Common/${::app}_nosync.app traffic-group none]

# <CRLSet> # Data Groups
if {$::config_crlset} {
    if {$::dg_crlset eq "#create-new#"} {
        set result [exec echo "\"status\" := \"waiting for initial update\"" > /var/tmp/empty.dgfile]
        set ::crlset_dgfile [iapp::conf create sys file data-group ${::no_sync_folder}/dg_crlset.file_$::app type string source-path file:///var/tmp/empty.dgfile]
        set ::dg_crlset [iapp::conf create ltm data-group external ${::no_sync_folder}/dg_crlset_$::app external-file-name $::crlset_dgfile]
    }
    if {$::dg_explicit_spki eq "#create-new#"} {
        set result [exec echo "\"status\" := \"waiting for initial update\"" > /var/tmp/empty.dgfile]
        set ::crlset_spki_dgfile [iapp::conf create sys file data-group ${::no_sync_folder}/dg_crlset_spki.file_$::app type string source-path file:///var/tmp/empty.dgfile]
        set ::dg_explicit_spki [iapp::conf create ltm data-group external ${::no_sync_folder}/dg_crlset_spki_$::app external-file-name $::crlset_spki_dgfile]
    }
}
# </CRLSet>

# <OneCRL>  # Data Groups
if {$::config_onecrl} {
    if {$::dg_onecrl eq "#create-new#"} {
        set result [exec echo "\"status\" := \"waiting for initial update\"" > /var/tmp/empty.dgfile]
        set ::onecrl_dgfile [iapp::conf create sys file data-group ${::no_sync_folder}/dg_onecrl.file_$::app type string source-path file:///var/tmp/empty.dgfile]
        set ::dg_onecrl [iapp::conf create ltm data-group external ${::no_sync_folder}/dg_onecrl_$::app external-file-name $::onecrl_dgfile]
    }
}
# </OneCRL>

# <CRLSet> # Update script
if {$::config_crlset} {
    # ifile
    set crlset_script {

}
    # if demodata is enabled, add demo data to the script
    set demodata {}
    if {$::config_demo} {
        set demodata $::demo_serial:$::demo_issuer_spki_hash
    }

    set result [exec echo "crlsetenv=\"[string map {\n {}} $crlset_script]\";" > /var/tmp/crlset_ifile.tmp]
    set result [exec echo "echo \$crlsetenv | base64 -id | gzip -d | dgfile=$::crlset_dgfile dgspkifile=$::crlset_spki_dgfile dgname=$::dg_crlset dgspkiname=$::dg_explicit_spki appname=$::app save_config=$::save_config demodata=$demodata /bin/bash;" >> /var/tmp/crlset_ifile.tmp]
    iapp::conf create sys file ifile crlsetupdate_$::app source-path file:///var/tmp/crlset_ifile.tmp

    # icall script
    set ::crlset_ifile_name "/config/filestore/files_d/Common_d/ifile_d/*crlsetupdate_${::app}*"
    set script [string map [list IFILE $::crlset_ifile_name] {exec /bin/bash -c "/bin/bash IFILE"}]
    set script_name [iapp::conf create sys icall script script_crlsetupdate.$::app definition \{ $script \}]

    # icall handler
    set occurance [clock format [expr {[clock seconds] + 7}] -format "%Y-%m-%d:%H:%M:%S"]
    iapp::conf create sys icall handler periodic icall_crlsetupdate.$::app \{ interval $::update_interval script $script_name first-occurrence $occurance\}
}
# </CRLSet>

# <OneCRL>  # Update script
if {$::config_onecrl} {
    # ifile
    set onecrl_script {

}
    set result [exec echo "onecrlenv=\"[string map {\n {}} $onecrl_script]\";" > /var/tmp/onecrl_ifile.tmp]
    set result [exec echo "echo \$onecrlenv | base64 -id | gzip -d | dgfile=$::onecrl_dgfile dgname=$::dg_onecrl appname=$::app save_config=$::save_config /bin/bash;" >> /var/tmp/onecrl_ifile.tmp]
    iapp::conf create sys file ifile onecrlupdate_$::app source-path file:///var/tmp/onecrl_ifile.tmp

    # icall script
    set ::onecrl_ifile_name "/config/filestore/files_d/Common_d/ifile_d/*onecrlupdate_${::app}*"
    set script [string map [list IFILE $::onecrl_ifile_name] {exec /bin/bash -c "/bin/bash IFILE"}]
    set script_name [iapp::conf create sys icall script script_onecrlupdate.$::app definition \{ $script \}]

    # icall handler
    set occurance [clock format [expr {[clock seconds] + 5}] -format "%Y-%m-%d:%H:%M:%S"]
    iapp::conf create sys icall handler periodic icall_onecrlupdate.$::app \{ interval $::update_interval script $script_name first-occurrence $occurance\}
}
# </OneCRL>

# cleanup and generate iRule code
set iRule_code [expand $iRule_code]
set iRule_code [regsub -all -line {^\s*\#.*$} $iRule_code {#}]
set iRule_code [regsub -all {\#\n} $iRule_code {}]
set iRule_code [iapp::conf create ltm rule /Common/ssl-certificate-revocation-checking_$::app $iRule_code]

set APIiRule_code [expand $APIiRule_code]
set APIiRule_code [regsub -all -line {^\s*\#.*$} $APIiRule_code {#}]
set APIiRule_code [regsub -all {\#\n} $APIiRule_code {}]
set APIiRule_code [iapp::conf create ltm rule /Common/ssl-certificate-revocation-checking-api_$::app $APIiRule_code]


iapp::conf create ltm virtual vs_visibility_$::app \{ \
    destination $::config_transparency_vs_address:443 \
    ip-protocol tcp \
    profiles replace-all-with \{ \
        clientssl \{ context clientside \} \
        f5-tcp-progressive \{ \} \
        http \{ \} \
    \} \
    rules \{ /Common/ssl-certificate-revocation-checking-api_$::app \} \
\}

# disable strict updates for datagroup updates
iapp::conf modify sys application service $tmsh::app_name strict-updates disabled

iapp::template stop
