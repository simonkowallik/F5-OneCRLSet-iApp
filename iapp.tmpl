        choice debuglogging_certificate_chain default "Off" display "medium" tcl { return "Off\t0\n! --- On --- !\t1\n" }
        choice debuglogging_crlset_blockedissuers default "Off" display "medium" tcl { return "Off\t0\n! --- On --- !\t1\n" }
        choice debuglogging_onecrl_blockedissuers default "Off" display "medium" tcl { return "Off\t0\n! --- On --- !\t1\n" }
        choice debuglogging_include_virtual default "Off" display "medium" tcl { return "Off\t0\n! --- On --- !\t1\n" }
